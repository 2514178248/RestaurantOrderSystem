/* login.wxss —— B1「菜单编辑部」 */

page {
  background: var(--paper);
  color: var(--ink);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* 内容 */
.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 72rpx 64rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 区块1：品牌区 */
.title-box {
  text-align: center;
}
.title {
  font-family: Georgia, 'Songti SC', serif;
}
.title1 {
  font-size: 56rpx;
  color: var(--green-deep);
  letter-spacing: 8rpx;
  line-height: 1.25;
}
.brand-rule {
  width: 64rpx;
  height: 4rpx;
  background: var(--gold);
  margin: 20rpx auto;
}
.title2 {
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 6rpx;
  color: var(--muted);
}

/* 区块2：副标题区 */
.font-middle {
  text-align: center;
  margin-top: 40rpx;
}
.subtitle {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  line-height: 1.7;
}
.subtitle1 {
  margin-bottom: 8rpx;
}

/* 区块3：登录框 */
.login-eare {
  margin-top: 88rpx;
}

.input-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 1px dashed var(--line);
}
.input-icon {
  display: none;
}
.input {
  flex: 1;
  height: 88rpx;
  font-family: Consolas, 'Courier New', monospace;
  font-size: 30rpx;
  color: var(--ink);
  background: transparent;
  border: 0;
}
.error {
  color: var(--stamp-red);
  font-size: 22rpx;
  margin-top: 16rpx;
}
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 48rpx;
  padding: 0;
  background: var(--green);
  color: #fff;
  border-radius: 0;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}
.login-btn::after {
  border: none;
}
.login-btn[disabled] {
  background: var(--muted);
  color: var(--paper-2);
}
.protocol {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--muted);
}
.protocol radio {
  transform: scale(0.75);
  margin-right: 4rpx;
}
.protocol .link {
  color: var(--green);
  margin: 0 4rpx;
  border-bottom: 1px solid var(--line);
}
