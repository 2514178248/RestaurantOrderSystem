/**payment-success.wxss — B1「菜单编辑部」主题*/
page {
  background: var(--paper);
  color: var(--ink);
}

.successcontainer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx 100rpx;
  text-align: center;
}

.successicon {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 80rpx;
  line-height: 1;
  color: var(--gold);
  margin: 120rpx auto 40rpx;
  animation: scaleIn 0.5s ease-in-out;
}

@keyframes scaleIn {
  from {
    transform: scale(0);
  }
  to {
    transform: scale(1);
  }
}

.successtitle {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 44rpx;
  color: var(--green-deep);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.successdesc {
  font-size: 26rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  margin-bottom: 60rpx;
}

.orderinfo {
  width: 100%;
  padding: 24rpx 0;
  margin-bottom: 60rpx;
}

.infoitem {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.label {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.value {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 26rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.buttongroup {
  display: flex;
  gap: 24rpx;
  width: 100%;
  margin-bottom: 40rpx;
}

.btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 4rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  text-align: center;
  box-sizing: border-box;
}

.btnprimary {
  background: var(--green);
  color: var(--paper-2);
}

.btnsecondary {
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
}

.countdowntext {
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  text-align: center;
}

.countdowntext text {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 22rpx;
}
