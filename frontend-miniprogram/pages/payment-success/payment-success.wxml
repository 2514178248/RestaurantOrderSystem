<view class="successcontainer">
  <view class="successicon">✓</view>
  <view class="successtitle">支付成功</view>
  <view class="successdesc">您的订单已提交，商家正在准备中</view>
  
  <view class="orderinfo">
    <view class="infoitem">
      <text class="label">订单号：</text>
      <text class="value">{{orderNo}}</text>
    </view>
  </view>

  <view class="buttongroup">
    <view class="btn btnprimary" bindtap="viewOrderDetail">查看订单</view>
    <view class="btn btnsecondary" bindtap="goHome">返回首页</view>
  </view>

  <view class="countdowntext">
    <text>{{countdown}}</text> 秒后自动返回首页
  </view>
</view>
