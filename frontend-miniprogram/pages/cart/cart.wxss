/* cart.wxss — B1 编辑部风格（类名与 wxml 对应，勿改类名） */
.page { height: 100vh; background: var(--paper); display: flex; flex-direction: column; }

/* 空态 */
.empty-cart { text-align: center; padding: 200rpx 60rpx; color: var(--muted); }
.empty-icon { font-size: 80rpx; }
.empty-title { font-family: Georgia, 'Songti SC', serif; font-size: 40rpx; color: var(--ink); margin-top: 24rpx; }
.empty-desc { font-size: 24rpx; margin-top: 12rpx; }
.empty-btn {
  margin: 48rpx auto 0;
  width: 280rpx;
  padding: 20rpx 0;
  border: 1px solid var(--green);
  color: var(--green);
  border-radius: 4rpx;
  letter-spacing: 4rpx;
}

/* 头部操作行 */
.cart-content { flex: 1; display: flex; flex-direction: column; }
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1px dashed var(--line);
}
.header-left { display: flex; align-items: center; gap: 12rpx; }
.header-text { font-size: 24rpx; color: var(--muted); }
.clear-btn { font-size: 24rpx; color: var(--stamp-red); letter-spacing: 2rpx; }

/* 列表行式 */
.goods-list { flex: 1; }
.cart-row { display: flex; align-items: center; }
.check-wrap { width: 72rpx; display: flex; justify-content: center; }
.select-circle {
  width: 34rpx; height: 34rpx;
  border: 1px solid var(--green);
  border-radius: 50%;
  background: transparent;
}
.select-circle.active { background: var(--green); }

.cart-item { flex: 1; position: relative; overflow: hidden; display: flex; }
.item-main {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 0;
  border-bottom: 1px dashed var(--line);
  transition: transform .2s;
  width: 100%;
  background: var(--paper);
}
.cart-item.swiped .item-main { transform: translateX(-140rpx); }
.goods-image { width: 120rpx; height: 120rpx; border-radius: 4rpx; background: #E9E4D8; flex: none; }
.goods-info { flex: 1; min-width: 0; }
.goods-name { font-family: Georgia, 'Songti SC', serif; font-size: 28rpx; font-weight: 700; color: var(--ink); }
.goods-desc { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.goods-price { margin-top: 10rpx; font-family: Consolas, monospace; font-size: 26rpx; font-weight: 700; color: var(--green); }

.item-quantity { display: flex; align-items: center; gap: 4rpx; align-self: flex-end; }
.qty-btn {
  width: 44rpx; height: 44rpx;
  border: 1px solid var(--green);
  color: var(--green);
  border-radius: 4rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  background: var(--paper-2);
}
.qty-value { min-width: 44rpx; text-align: center; font-size: 26rpx; color: var(--ink); }

.delete-btn {
  position: absolute; right: 0; top: 0; bottom: 0;
  width: 140rpx;
  background: var(--stamp-red);
  color: #fff;
  font-size: 26rpx;
  border-radius: 0;
  transform: translateX(100%); /* 默认藏到可视区外，由 overflow:hidden 裁剪 */
  transition: transform .2s;
  display: flex; align-items: center; justify-content: center;
}
.cart-item.swiped .delete-btn { transform: translateX(0); }
.list-gap { height: 200rpx; }

/* 底部支付条 */
.pay-popup {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--paper-2);
  border-top: 1px solid var(--line);
  transform: translateY(100%);
  transition: transform .2s;
}
.pay-popup.show { transform: translateY(0); }
.popup-inner { padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.popup-row { display: flex; justify-content: space-between; font-size: 24rpx; color: var(--muted); }
.popup-count { font-size: 24rpx; color: var(--muted); }
.popup-total { font-family: Consolas, monospace; color: var(--green); font-weight: 700; }
.pay-btn {
  margin-top: 20rpx;
  width: 100%;
  background: var(--green);
  color: #fff;
  font-family: Georgia, 'Songti SC', serif;
  letter-spacing: 6rpx;
  border-radius: 4rpx;
  font-size: 30rpx;
}
.pay-btn.disabled { background: var(--muted); color: var(--paper-2); }

/* 编辑部头部（与首页一致，依赖 app.wxss 基元类） */
.editorial-head { padding: 24rpx 32rpx 32rpx; }
.editorial-title { color: var(--green-deep); }
.editorial-meta { color: var(--muted); }
