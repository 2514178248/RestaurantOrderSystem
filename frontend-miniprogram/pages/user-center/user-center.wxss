/**user-center.wxss*/
.top-card{
  margin-bottom:0 ;
  background-color:#ffd84a ;
  height: 100px;
  width: 100vh;
}
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 用户信息 */
.userprofile {
  background: linear-gradient(135deg, #ffd84a 0%, #0a0a09 100%);
  padding: 30rpx 20rpx;
  color: #fff;
}

.profilecard {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.userinfo {
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.userstatus {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 订单统计 */
.orderstats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
  padding: 20rpx;
  background-color: #fff;
  margin: 15rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.statitem {
  text-align: center;
  padding: 20rpx 10rpx;
  border-radius: 8rpx;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.statitem:active {
  background-color: #f5f5f5;
}

.statcount {
  font-size: 32rpx;
  color: #1296db;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.statlabel {
  font-size: 22rpx;
  color: #666;
}

/* 订单查询 */
.searchsection {
  background-color: #fff;
  margin: 15rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}

.sectiontitle {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.searchbox {
  display: flex;
  gap: 10rpx;
}

.searchinput {
  flex: 1;
  padding: 12rpx 15rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.searchbtn {
  padding: 12rpx 30rpx;
  background-color: #1296db;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 功能菜单 */
.menusection {
  margin: 15rpx;
}

.menugroup {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.menuitem {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.menuitem:last-child {
  border-bottom: none;
}

.menuitem:active {
  background-color: #f5f5f5;
}

.menuicon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.menutitle {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menuarrow {
  color: #ccc;
  font-size: 24rpx;
}

/* 登出按钮 */
.logoutsection {
  padding: 20rpx;
  margin: 30rpx 15rpx;
}

.logoutbtn {
  padding: 20rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.logoutbtn:active {
  background-color: #ff5252;
}
