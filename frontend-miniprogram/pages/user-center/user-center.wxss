/**user-center.wxss —— B1「菜单编辑部」*/

page {
  background: var(--paper);
  color: var(--ink);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

.scrollarea {
  flex: 1;
  min-height: 0;
}

/* 用户信息：编辑部头部 */
.userprofile {
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 2rpx solid var(--ink);
}

.profile-kicker {
  margin-bottom: 20rpx;
}

.profilecard {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 4rpx;
  background-color: #E9E4D8;
  border: 1px solid var(--line);
  flex-shrink: 0;
}

.userinfo {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 44rpx;
  line-height: 1.25;
  color: var(--green-deep);
  letter-spacing: 2rpx;
}

.userstatus {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* 订单统计：行式，虚线竖分隔 */
.orderstats {
  display: flex;
  margin: 0 32rpx;
  padding: 28rpx 0;
  border-bottom: 1px dashed var(--line);
}

.statitem {
  flex: 1;
  text-align: center;
  border-right: 1px dashed var(--line);
}

.statitem:last-child {
  border-right: none;
}

.statcount {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 40rpx;
  line-height: 1.1;
  color: var(--green);
}

.statlabel {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.statitem:active .statcount {
  color: var(--gold);
}

/* 订单查询 */
.searchsection {
  padding: 32rpx 32rpx 28rpx;
  border-bottom: 1px dashed var(--line);
}

.sectiontitle {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--green-deep);
  margin-bottom: 16rpx;
}

.searchbox {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
}

.searchinput {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 4rpx;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--line);
  font-family: Consolas, 'Courier New', monospace;
  font-size: 26rpx;
  color: var(--ink);
}

.searchbtn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background: var(--green);
  color: #fff;
  border-radius: 2rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

/* 功能菜单：行式 */
.menusection {
  padding: 30rpx 32rpx 0;
  border-bottom: 1px dashed var(--line);
}

.menu-kicker {
  color: var(--gold);
  margin-bottom: 8rpx;
}

.menugroup {
  background: transparent;
}

.menuitem {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1px dashed var(--line);
}

.menuitem:last-child {
  border-bottom: none;
}

.menuitem:active {
  background: rgba(35, 40, 31, 0.03);
}

.menuicon {
  display: none;
}

.menutitle {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.menuarrow {
  width: 14rpx;
  height: 14rpx;
  font-size: 0;
  color: transparent;
  border-top: 2rpx solid var(--gold);
  border-right: 2rpx solid var(--gold);
  transform: rotate(45deg);
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* 登出按钮 */
.logoutsection {
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.logoutbtn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: 1rpx solid var(--stamp-red);
  color: var(--stamp-red);
  background: transparent;
  border-radius: 4rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.logoutbtn:active {
  background: rgba(181, 72, 47, 0.06);
}
