/**order-confirm.wxss 订单确认页样式*/
.top-card{
  margin-bottom:0 ;
  background-color:#ffd84a ;
  height: 100px;
  width: 100vh;
}
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 120rpx;
}

/* 区块 */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.sectiontitle {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}

/* 取餐信息 */
.meallocationsection {
  position: relative;
}

.meallocationcard {
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border-left: 4rpx solid #1296db;
  position: relative;
}

.locationinfo,
.phoneinfo {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.locationlabel,
.phonelabel {
  color: #666;
  margin-right: 10rpx;
  min-width: 90rpx;
}

.locationvalue,
.phonevalue {
  color: #333;
  font-weight: bold;
  flex: 1;
}

.editbtn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: #1296db;
  color: #fff;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 商品列表 */
.goodslistsection {
}

.goodslist {
  margin-bottom: 20rpx;
}

.goodsitemconfirm {
  display: flex;
  gap: 15rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.goodsitemconfirm:last-child {
  border-bottom: none;
}

.goodsimagesmall {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.goodsimagesmall image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.goodsinfoconfirm {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goodsname {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.goodsdetails {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.priceqty {
  display: flex;
  gap: 10rpx;
  font-size: 24rpx;
}

.goodsprice {
  color: #ff6b35;
  font-weight: bold;
}

.goodsqty {
  color: #999;
}

.goodssubtotal {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: bold;
}

/* 订单统计 */
.ordersummary {
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  margin-top: 15rpx;
}

.summaryrow {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.summaryrow:last-child {
  margin-bottom: 0;
}

.totalpricerow {
  padding-top: 10rpx;
  border-top: 1rpx solid #eee;
  color: #ff6b35;
  font-weight: bold;
}

.totalprice {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

/* 支付方式 */
.paymentsection {
}

.paymentmethod {
  display: flex;
  gap: 15rpx;
}

.methoditem {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid #1296db;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.methodicon {
  font-size: 48rpx;
}

.methodname {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
}

/* 操作栏 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 15rpx;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.cancelbtn,
.paybtn {
  flex: 1;
  padding: 20rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancelbtn {
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid #ddd;
}

.paybtn {
  flex: 1.5;
  background-color: #1296db;
  color: #fff;
}

.paybtn.paying {
  opacity: 0.7;
}

.payamount {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 5rpx;
}
