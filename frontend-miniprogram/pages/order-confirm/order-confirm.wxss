/**order-confirm.wxss 订单确认页样式（B1「菜单编辑部」）*/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  color: var(--ink);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 区块：纸面平铺，容器间虚线分隔 */
.section {
  margin: 20rpx 24rpx 0;
  padding: 8rpx 4rpx 28rpx;
  border-bottom: 1px dashed var(--line);
}

.sectiontitle {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 30rpx;
  color: var(--green-deep);
  letter-spacing: 2rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px dashed var(--line);
}

/* 取餐信息 */
.meallocationsection {
  position: relative;
}

.meallocationcard {
  padding: 4rpx 0;
}

.locationinfo,
.phoneinfo {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.locationlabel,
.phonelabel {
  color: var(--muted);
  margin-right: 10rpx;
  min-width: 140rpx;
  flex-shrink: 0;
}

.locationvalue,
.phonevalue {
  color: var(--ink);
  font-size: 26rpx;
  flex: 1;
  line-height: 1.6;
  padding-right: 140rpx;
}

.editbtn {
  position: absolute;
  top: 64rpx;
  right: 4rpx;
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
  padding: 6rpx 22rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* 商品清单 */
.goodslist {
  margin-bottom: 24rpx;
}

.goodsitemconfirm {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1px dashed var(--line);
}

.goodsitemconfirm:last-child {
  border-bottom: none;
}

.goodsimagesmall {
  width: 100rpx;
  height: 100rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #E9E4D8;
  flex-shrink: 0;
}

.goodsimagesmall image {
  width: 100%;
  height: 100%;
}

.goodsinfoconfirm {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goodsname {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.goodsdetails {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.priceqty {
  display: flex;
  gap: 12rpx;
}

.goodsprice {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 26rpx;
  color: var(--green);
  font-weight: 700;
}

.goodsqty {
  font-size: 22rpx;
  color: var(--muted);
}

.goodssubtotal {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 24rpx;
  color: var(--green);
  font-weight: 700;
}

/* 订单统计 */
.ordersummary {
  margin-top: 8rpx;
  padding-top: 4rpx;
}

.summaryrow {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.summaryrow:last-child {
  margin-bottom: 0;
}

.totalpricerow {
  padding-top: 16rpx;
  border-top: 1px dashed var(--line);
  color: var(--ink);
}

.totalprice {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 32rpx;
  color: var(--green);
  font-weight: 700;
}

/* 操作栏 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1px solid var(--line);
}

.cancelbtn,
.paybtn {
  flex: 1;
  padding: 22rpx;
  border-radius: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancelbtn {
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
  font-family: Georgia, 'Songti SC', serif;
  letter-spacing: 4rpx;
}

.paybtn {
  flex: 1.6;
  background: var(--green);
  color: #fff;
  font-family: Georgia, 'Songti SC', serif;
  letter-spacing: 6rpx;
}

.paybtn.paying {
  background: var(--muted);
  color: var(--paper-2);
}

.payamount {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 5rpx;
}
