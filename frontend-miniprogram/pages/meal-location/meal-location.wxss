/**meal-location.wxss*/
.top-card{
  margin-bottom:0 ;
  background-color:#ffd84a ;
  height: 100px;
  width: 100vh;
}
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 100rpx;
}

.formsection {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.formgroup {
  margin-bottom: 40rpx;
}

.formgroup:last-of-type {
  margin-bottom: 30rpx;
}

.formlabel {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
  display: block;
}

/* 地点选项 */
.locationoptions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.locationitem {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border: 2rpx solid #eee;
  cursor: pointer;
  transition: all 0.3s ease;
}

.locationitem.active {
  background-color: #e8f4fd;
  border-color: #1296db;
}

.checkbox {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.locationitem.active .checkbox {
  background-color: #1296db;
  border-color: #1296db;
}

.locationitem.active .checkbox::after {
  content: '✓';
  color: #fff;
  font-size: 16rpx;
  line-height: 1;
}

.locationitem text {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.locationitem.active text {
  color: #1296db;
  font-weight: bold;
}

/* 表单输入 */
.forminputgroup {
  position: relative;
}

.forminput {
  width: 100%;
  padding: 15rpx 20rpx;
  background-color: #f9f9f9;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.forminput:focus {
  background-color: #fff;
  border-color: #1296db;
}

/* 提示框 */
.tipbox {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 15rpx 20rpx;
  background-color: #f0f8ff;
  border-radius: 8rpx;
  border-left: 4rpx solid #1296db;
}

.tipicon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.tiptext {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 操作栏 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 15rpx;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.btncancel {
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid #ddd;
}

.btnconfirm {
  background-color: #1296db;
  color: #fff;
}
