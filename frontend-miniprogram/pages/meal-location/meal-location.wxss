/**meal-location.wxss —— B1「菜单编辑部」*/

page {
  background: var(--paper);
  color: var(--ink);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* 头部墨线 */
.page-rule {
  height: 2rpx;
  background: var(--ink);
  margin: 20rpx 32rpx 0;
}

.scrollarea {
  flex: 1;
  min-height: 0;
}

/* 底部留白交给滚动内容本身，避免部分内核下 scroll-view 的 padding 不进入滚动区 */
.formsection {
  padding: 8rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.formgroup {
  padding-bottom: 8rpx;
}

.formlabel {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--muted);
  margin: 28rpx 0 4rpx;
}

/* 地点选项：行式 */
.locationoptions {
  display: flex;
  flex-direction: column;
}

.locationitem {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 1px dashed var(--line);
}

.locationitem:last-child {
  border-bottom: none;
}

.locationitem:active {
  background: rgba(35, 40, 31, 0.03);
}

.checkbox {
  width: 8rpx;
  height: 8rpx;
  background: transparent;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.locationitem.active .checkbox {
  background: var(--green);
}

.locationitem text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.locationitem.active text {
  color: var(--green);
  font-weight: 700;
}

/* 表单输入：下划线 + 等宽 */
.forminputgroup {
  position: relative;
}

.forminput {
  width: 100%;
  height: 88rpx;
  padding: 0 4rpx;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--line);
  font-family: Consolas, 'Courier New', monospace;
  font-size: 28rpx;
  color: var(--ink);
}

/* 提示 */
.tipbox {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx 0 8rpx;
  margin-top: 32rpx;
  border-top: 1px dashed var(--line);
}

.tipicon {
  display: none;
}

.tiptext {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--muted);
  letter-spacing: 1rpx;
}

/* 操作栏 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1px solid var(--line);
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 0;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.btncancel {
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
}

.btnconfirm {
  background: var(--green);
  color: #fff;
  font-family: Georgia, 'Songti SC', serif;
}

.btn:active {
  opacity: 0.85;
}
