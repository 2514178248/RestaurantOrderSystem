/**order-list.wxss*/
.top-card{
  margin-bottom:0 ;
  background-color:#ffd84a ;
  height: 100px;
  width: 100vh;
}
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 空列表 */
.emptylist {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 500rpx;
  padding: 40rpx 20rpx;
  text-align: center;
}

.emptyicon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.emptytext {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.emptydesc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.emptybtn {
  padding: 20rpx 60rpx;
  background-color: #1296db;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 订单列表 */
.orderslist {
  padding: 20rpx;
}

.ordercard {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.orderheader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #f9f9f9;
}

.orderinfo {
  flex: 1;
}

.orderid {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 5rpx;
  font-family: monospace;
}

.ordertime {
  font-size: 22rpx;
  color: #999;
}

.orderstatus {
  font-size: 24rpx;
  color: #1296db;
  font-weight: bold;
  white-space: nowrap;
  padding: 8rpx 12rpx;
  background-color: #e8f4fd;
  border-radius: 20rpx;
}

/* 商品预览 */
.goodspreview {
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.goodspreviewitem {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  align-items: center;
}

.goodspreviewitem:last-child {
  margin-bottom: 0;
}

.goodsimg {
  width: 60rpx;
  height: 60rpx;
  border-radius: 6rpx;
  background-color: #f0f0f0;
}

.goodspreviewinfo {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.goodsname {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goodsprice {
  font-size: 22rpx;
  color: #ff6b35;
  font-weight: bold;
}

.goodsqty {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

/* 订单统计 */
.ordersummary {
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #f9f9f9;
}

.summarytotal {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 26rpx;
  color: #333;
}

.totalprice {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-left: 8rpx;
}

/* 订单操作 */
.orderactions {
  display: flex;
  gap: 10rpx;
  padding: 15rpx 20rpx;
}

.actionbtn {
  flex: 1;
  padding: 12rpx;
  background-color: #1296db;
  color: #fff;
  border-radius: 6rpx;
  font-size: 24rpx;
  text-align: center;
  font-weight: bold;
}
