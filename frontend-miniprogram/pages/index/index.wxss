/* index.wxss — B1 编辑部风格 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--paper);
}
.scrollarea { flex: 1; min-height: 0; }

/* 搜索栏 */
.searchcontainer { padding: 20rpx 32rpx 8rpx; }
.searchbox {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1px dashed var(--line);
  padding: 14rpx 4rpx;
}
.searchicon { font-size: 28rpx; color: var(--muted); }
.searchinput {
  flex: 1;
  height: 48rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: transparent;
}
.clearicon {
  font-size: 30rpx;
  color: var(--muted);
  padding: 0 10rpx;
}

/* 分类导航：文字 tab + 选中短墨线 */
.categorycontainer { white-space: nowrap; }
.categorylist { display: flex; padding: 20rpx 32rpx 4rpx; gap: 36rpx; }
.categoryitem {
  display: inline-flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 28rpx;
  color: var(--muted);
}
.categoryitem.active { color: var(--green); font-weight: 800; }
.categoryitem.active .catname { border-bottom: 4rpx solid var(--green); padding-bottom: 6rpx; }

/* 商品网格 */
.goodscontainer { padding: 16rpx 32rpx 60rpx; min-height: 500rpx; }
.loadingtext, .emptytext {
  text-align: center;
  padding: 120rpx 0;
  color: var(--muted);
  font-size: 26rpx;
}
.emptytext .u-empty-line { margin-bottom: 24rpx; }
.goodslist { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36rpx 32rpx; }
.goodsitem { display: flex; flex-direction: column; }
.goodsimage {
  width: 100%;
  height: 300rpx;
  background-color: #E9E4D8;
  border-radius: 4rpx;
  filter: saturate(.92);
}
.goodsinfo { padding: 16rpx 4rpx 0; }
.goodsname { display: flex; justify-content: space-between; align-items: baseline; }
.goodsname-text {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.goodsno { font-size: 20rpx; color: var(--gold); letter-spacing: 2rpx; }
.goodsdesc {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goodsprice { margin-top: 14rpx; }
.goodsprice-value { font-size: 34rpx; }
