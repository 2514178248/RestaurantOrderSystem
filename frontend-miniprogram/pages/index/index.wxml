<!--index.wxml — B1 编辑部风格（绑定结构与旧版逐字对应）-->
<navigation-bar title="食光小馆" back="{{false}}" background="#F7F4EC" color="#23281F"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <!-- 编辑部头部 -->
  <view class="editorial-head u-editorial-head">
    <view class="u-kicker">SHIGUANG · WEEKLY MENU</view>
    <view class="editorial-title u-editorial-title">今日菜单</view>
    <view class="editorial-meta u-editorial-meta">
      <text>今天想吃点什么？</text>
      <text>午市 11:00 — 14:00</text>
    </view>
  </view>
  <view class="u-rule-strong"></view>

  <!-- 搜索栏（虚线下边线式） -->
  <view class="searchcontainer">
    <view class="searchbox">
      <text class="searchicon">🔍</text>
      <input
        class="searchinput"
        placeholder="搜索商品名称"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
      <view wx:if="{{searchKeyword}}" class="clearicon" bindtap="clearSearch">×</view>
    </view>
  </view>

  <!-- 分类导航（文字 + 选中短墨线） -->
  <scroll-view class="categorycontainer" scroll-x>
    <view class="categorylist">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="categoryitem {{item.active ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="switchCategory"
      >
        <text class="catname">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 商品列表 -->
  <view class="goodscontainer">
    <view wx:if="{{loading}}" class="loadingtext">菜单加载中…</view>
    <view wx:elif="{{filteredGoodsList.length === 0}}" class="emptytext">
      <view class="u-empty-line"></view>
      今日暂无相关菜品
    </view>
    <view wx:else class="goodslist">
      <view
        wx:for="{{filteredGoodsList}}"
        wx:key="id"
        wx:if="{{item.status == 1}}"
        class="goodsitem"
        data-goods="{{item}}"
        bindtap="addToCart"
      >
        <image class="goodsimage" src="{{item.image || '/images/default-goods.jpg'}}" mode="aspectFill"></image>
        <view class="goodsinfo">
          <view class="goodsname">
            <text class="goodsname-text">{{item.name}}</text>
            <text class="goodsno">N°{{index < 9 ? '0' : ''}}{{index + 1}}</text>
          </view>
          <view class="goodsdesc">{{item.description || ''}}</view>
          <view class="goodsprice u-leader-price">
            <text class="goodsprice-value u-price"><text class="u-rmb">¥</text>{{item.price}}</text>
            <view class="u-leader"></view>
            <view class="addcartbtn u-add-btn">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
