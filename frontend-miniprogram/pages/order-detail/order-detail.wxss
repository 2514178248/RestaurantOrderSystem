/**order-detail.wxss*/
.top-card{
  margin-bottom:0 ;
  background-color:#ffd84a ;
  height: 100px;
  width: 100vh;
}
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 100rpx;
}

/* 状态部分 */
.statussection {
  padding: 20rpx;
}

.statuscard {
  border-radius: 12rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  color: #fff;
}

.statuscard.pending {
  background: linear-gradient(135deg, #ff9f00 0%, #ff8a00 100%);
}

.statuscard.paid {
  background: linear-gradient(135deg, #1296db 0%, #0a7ec8 100%);
}

.statuscard.completed {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.statuscard.cancelled {
  background: linear-gradient(135deg, #d9d9d9 0%, #bfbfbf 100%);
}

.statusicon {
  font-size: 64rpx;
  margin-bottom: 15rpx;
}

.statustitle {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.statusdesc {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin: 15rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.sectiontitle {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}

/* 订单信息 */
.inforow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 26rpx;
}

.inforow:last-child {
  border-bottom: none;
}

.infolabel {
  color: #666;
  flex: 0 0 120rpx;
}

.infovalue {
  color: #333;
  flex: 1;
  text-align: right;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.copybtn {
  background-color: #1296db;
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

/* 取餐信息 */
.mealcard {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 15rpx;
  border-left: 4rpx solid #1296db;
}

.mealitem {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  align-items: flex-start;
}

.mealitem:last-child {
  margin-bottom: 0;
}

.mealicon {
  font-size: 28rpx;
  flex-shrink: 0;
  width: 30rpx;
  text-align: center;
}

.mealcontent {
  flex: 1;
}

.meallabel {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.mealvalue {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

/* 商品详情 */
.goodslist {
  margin-bottom: 20rpx;
}

.goodsitemdetail {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
  align-items: center;
}

.goodsitemdetail:last-child {
  border-bottom: none;
}

.goodsimg {
  width: 70rpx;
  height: 70rpx;
  border-radius: 6rpx;
  background-color: #f0f0f0;
}

.goodsinfo {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.goodsname {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.goodsspec {
  font-size: 22rpx;
  color: #999;
}

.goodsamount {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: bold;
  white-space: nowrap;
}

/* 费用清单 */
.feesummary {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 15rpx;
  margin-top: 15rpx;
}

.feerow {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eee;
}

.feerow:last-child {
  border-bottom: none;
}

.totalrow {
  padding-top: 10rpx;
  margin-top: 5rpx;
  border-top: 1rpx solid #eee;
  border-bottom: none;
  color: #333;
  font-weight: bold;
  font-size: 26rpx;
}

.totalprice {
  color: #ff6b35;
  font-size: 28rpx;
  font-weight: bold;
}

/* 支付方式 */
.paymentsection {
}

.paymentmethod {
  display: flex;
  gap: 15rpx;
}

.methoditem {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid #1296db;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.methodicon {
  font-size: 48rpx;
}

.methodname {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
}

/* 操作栏 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 10rpx;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.actionbtn {
  flex: 1;
  padding: 20rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.actionbtn.primary {
  background-color: #1296db;
  color: #fff;
}

.actionbtn.secondary {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
}

.actionbtn.danger {
  background-color: #ff6b6b;
  color: #fff;
}
