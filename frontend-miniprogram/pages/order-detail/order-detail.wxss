/**order-detail.wxss — B1「菜单编辑部」订单详情*/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

/* 旧的顶部色块占位：保留节点，仅隐藏 */
.top-card {
  display: none;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  overflow-y: hidden;
}

/* 状态区：衬线状态词 + 金色短线 */
.statussection {
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1px dashed var(--line);
}

.statuscard {
  text-align: left;
}

.statusicon {
  display: none;
}

.statustitle {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 44rpx;
  color: var(--green-deep);
  line-height: 1.2;
}

.statusrule {
  width: 64rpx;
  height: 4rpx;
  background: var(--gold);
  margin: 18rpx 0 16rpx;
}

.statusdesc {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.statuscard.cancelled .statustitle {
  color: var(--stamp-red);
}

/* 通用区块：纸面平铺，区块间虚线 */
.section {
  margin: 0 32rpx;
  padding: 28rpx 0 32rpx;
  border-bottom: 1px dashed var(--line);
}

/* 末个区块补底部留白，避免被固定操作栏遮住 */
.section:last-child {
  border-bottom: none;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.sectiontitle {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
  margin-bottom: 18rpx;
}

/* 订单信息 */
.inforow {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 0;
}

.infolabel {
  flex: 0 0 140rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.infovalue {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  font-size: 26rpx;
  color: var(--ink);
  text-align: right;
  word-break: break-all;
}

.ordernorow .infovalue {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.copybtn {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
  border-radius: 2rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* 取餐信息 */
.mealcard {
  padding: 0;
}

.mealitem {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 6rpx 0;
}

.mealicon {
  display: none;
}

.mealcontent {
  flex: 1;
}

.meallabel {
  font-size: 22rpx;
  color: var(--muted);
}

.mealvalue {
  font-size: 26rpx;
  color: var(--ink);
  margin-top: 4rpx;
}

/* 商品详情：行式，虚线分隔 */
.goodslist {
  margin-bottom: 8rpx;
}

.goodsitemdetail {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px dashed var(--line);
}

.goodsitemdetail:last-child {
  border-bottom: none;
}

.goodsimg {
  width: 72rpx;
  height: 72rpx;
  border-radius: 2rpx;
  background: #E9E4D8;
  flex-shrink: 0;
  filter: saturate(.92);
}

.goodsinfo {
  flex: 1;
  min-width: 0;
}

.goodsname {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goodsspec {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.goodsamount {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--green);
  text-align: right;
  white-space: nowrap;
}

/* 费用清单 */
.feesummary {
  padding-top: 18rpx;
  border-top: 1px dashed var(--line);
}

.feerow {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 6rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.feerow text:last-child {
  font-family: Consolas, 'Courier New', monospace;
}

.totalrow {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1px dashed var(--line);
  font-size: 24rpx;
  color: var(--ink);
}

.totalprice {
  font-family: Consolas, 'Courier New', monospace;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green);
}

/* 支付方式 */
.paymentmethod {
  padding: 2rpx 0;
}

.methoditem {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border: 1px solid var(--green);
  border-radius: 2rpx;
  color: var(--green);
}

.methodicon {
  display: none;
}

.methodname {
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

/* 操作栏：主按钮墨绿实底，其余描边 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1px dashed var(--line);
}

.actionbtn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx;
  border-radius: 2rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.actionbtn.primary {
  flex: 1.4;
  background: var(--green);
  color: #fff;
  font-family: Georgia, 'Songti SC', serif;
  letter-spacing: 4rpx;
}

.actionbtn.primary.disabled {
  background: var(--muted);
  color: var(--paper-2);
}

.actionbtn.secondary {
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
}

.actionbtn.danger {
  background: transparent;
  border: 1px solid var(--stamp-red);
  color: var(--stamp-red);
}
